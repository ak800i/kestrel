<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Spike S1's location check (design spec, section 19). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- The hook goal-control do=send-later has a goal notification's button sent a few seconds later by an exact alarm
         (plan 7E, Task 8, Step 8a). Android grants USE_EXACT_ALARM at the install (API 33 and later, Kestrel's minimum),
         so the hook changes no setting of the phone; release builds do not have it. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Debug builds start the hooks' process-wide rules as each process starts, before any of the graph's work
         (DebugKestrelApplication; review I2 of plan 7F). Release builds keep KestrelApplication. -->
    <application
        android:name=".debug.DebugKestrelApplication"
        tools:replace="android:name">
        <!-- Test hooks for adb (design spec, section 16.1), called with adb shell content call on content://dev.kestrel.hooks.
             Only callers that hold DUMP, in practice adb shell, can acquire it, and TestHookProvider checks each call's
             caller again, because Android checks no permission on a call. Release builds do not contain this provider,
             and the audit checks that. -->
        <provider
            android:name=".debug.TestHookProvider"
            android:authorities="dev.kestrel.hooks"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- A screen with a "Mute" switch for the call check of scripts\listen-check.ps1: another app's control with the
             label of an in-call control. Only callers that hold DUMP, in practice adb shell, can start it. It keeps a
             task of its own, so that the check can bring the same screen back to the front and read its switch. -->
        <activity
            android:name=".debug.CallFixtureActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:permission="android.permission.DUMP"
            android:taskAffinity="dev.kestrel.fixture" />

        <!-- A screen with two buttons named "Delete" for the check "Which one?" of scripts\a71-commands.ps1. Only callers
             that hold DUMP, in practice adb shell, can start it. -->
        <activity
            android:name=".debug.TwinButtonsActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:taskAffinity="dev.kestrel.twins" />

        <!-- Compose UI tests show their screens in this empty activity. ui-test-manifest declares it as exported, so
             any app could start it. The tests run in Kestrel's own process and can start it without that. -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false"
            tools:replace="android:exported" />
    </application>
</manifest>
