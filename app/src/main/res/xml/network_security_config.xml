<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!--
        Android refuses plain HTTP by default, but the owner's local servers need it (design spec, section 13.1).
        NetworkPolicy still refuses plain HTTP except to the local servers that the owner adds, and the audit
        forbids other HTTP clients in Kestrel's code.
    -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
