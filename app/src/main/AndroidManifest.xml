<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Asked for in the setup checklist (design spec, sections 13.6 and 15). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Granted at install, for ListeningService (design spec, sections 7.2 and 13.6). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Granted at install. Kestrel asks for the earbuds as the device of calls' audio when the owner allows the earbud
         microphone (design spec, section 8.8; research r12). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Optional, in the setup checklist: the call state, for the modes Ringing and In call, and the answer, decline and
         hang-up through Android's call API (design spec, sections 8.7 and 13.6). Kestrel reads no phone number and no
         call log. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- "Show previous app" leaves out the home app: a switch that ends on the home screen, as with a single task, is no
         switch (the overview is told by Android's recents component; design D9 of sub-project 3, spec 13.6). Since
         Android 11 an app sees the home app only when it declares its intent here. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>
    <!-- Optional, asked for at the first "call [name]": the contacts, which Kestrel reads and matches only on the phone
         (design spec, section 13.6). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Granted at install, for SignInService, which keeps a sign-in running while the browser is in front (design D10 of
         sub-project 4; prototype P5). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 17 and later, asked for when the owner checks a server on the local network; loopback needs none (design
         D11 of sub-project 4). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Sign-in pages open in a Custom Tab, in Chrome when Chrome offers the Custom Tabs service (design D10 of
         sub-project 4). -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
    <!-- Plan 3C: permissions -->
    <!-- sub-project 5B: permissions -->
    <!-- Asked together at the agent's first find_media; from Android 14 the owner may give only selected photos (design
         D12 of sub-project 5). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Asked at the agent's first list_events, list_sms and list_calls (design D12 of sub-project 5). Kestrel never asks for
         SEND_SMS: an SMS is sent on the SMS app's screen. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- READ_SMS would make Google Play require telephony; Kestrel only reads SMS, so it needs none (lint's
         PermissionImpliesUnsupportedChromeOsHardware). -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Granted at install, for the clock intents of set_alarm and set_timer. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Asked together at the agent's first get_location, which uses only the GPS provider (design D12 of sub-project 5);
         Android may give only the approximate location. Never ACCESS_BACKGROUND_LOCATION. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Kestrel boosts the names of the apps that the launcher shows (design spec, sections 8.3 and 13.6). Since Android
         11 an app sees the other apps' launcher activities only when it declares their intent here. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <!-- sub-project 5B: queries -->
    <!-- The apps and handlers that the agent's tools name (design D11 and D12 of sub-project 5; D32 item 32): the share
         targets, Waze, Google Maps and the browsers by package, https links, the deep-link schemes of open_deep_link, the
         calendar's insert screen, the clock, the SMS app and the settings pages of open_settings. -->
    <queries>
        <package android:name="org.telegram.messenger" />
        <package android:name="org.telegram.messenger.web" />
        <package android:name="com.whatsapp" />
        <package android:name="com.viber.voip" />
        <package android:name="com.google.android.gm" />
        <package android:name="com.waze" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="org.mozilla.firefox_beta" />
        <package android:name="org.mozilla.fenix" />
        <package android:name="com.android.chrome" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="viber" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="whatsapp" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tg" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="waze" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.settings.WIFI_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.BLUETOOTH_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.TETHER_SETTINGS" />
        </intent>
        <intent>
            <action android:name="com.android.settings.WIFI_TETHER_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.WIRELESS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DATA_USAGE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DISPLAY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SOUND_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.LOCATION_SOURCE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.BATTERY_SAVER_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DATE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.ALL_APPS_NOTIFICATION_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
    </queries>
    <!-- sub-project 5C: queries -->

    <application
        android:name=".KestrelApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Kestrel"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- singleTop: "What can I say?" while the settings app is in front delivers its page to the open app. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reads the screen and acts on it (design spec, sections 7.2 and 9.1). -->
        <service
            android:name=".KestrelAccessibilityService"
            android:exported="true"
            android:label="Kestrel"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Keeps a sign-in running while the owner signs in in the browser, with a notification and Cancel (design D10 of
             sub-project 4). -->
        <service
            android:name=".providers.SignInService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Keeps Kestrel listening, with the microphone and voice output (design spec, sections 7.2 and 8.5). -->
        <service
            android:name=".listen.ListeningService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />

        <!-- The listening notification's Pause, Resume and Stop (design spec, section 8.6). Only Kestrel's own
             PendingIntents reach it. -->
        <receiver
            android:name=".listen.NotificationActionReceiver"
            android:exported="false" />

        <!-- The Quick Settings tile that toggles listening (design spec, sections 7.2 and 8.6). Only SystemUI, which holds
             BIND_QUICK_SETTINGS_TILE, can bind it. -->
        <service
            android:name=".listen.KestrelTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="Kestrel"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- The assistant role (design spec, section 8.6; research r6): the service that makes Kestrel eligible, the
             session that the assistant gesture opens, and the recognition service that the role requires. Only Android,
             which holds BIND_VOICE_INTERACTION, can bind them. -->
        <service
            android:name=".assist.KestrelAssistantService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction" />
        </service>
        <service
            android:name=".assist.KestrelSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service
            android:name=".assist.KestrelRecognitionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

        <!-- The earbuds' and headsets' assistant button (design spec, section 8.6; prototype P3): transparent, with no
             place in the recent apps or the back stack, and in a task of its own, so that closing it brings back the
             app that was in front. Not WEB_SEARCH, which other apps send for typed web searches. -->
        <activity
            android:name=".assist.AssistActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.speech.action.VOICE_SEARCH_HANDS_FREE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- EmojiCompat would ask Google Play services for a downloadable emoji font. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
        <!-- sub-project 5B: components -->
    </application>
</manifest>
