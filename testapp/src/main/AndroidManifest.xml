<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- For NotificationActivity's notification: the command tests grant it, and command-test.ps1 takes it back. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- For the cross-app overlays of injection fixture 6 and ObscuringActivity: :tools:eval and the device test
         TypedBoundaryTest allow it with appops and put it back. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- DUMP is a development permission, which only pm grant gives. TestHookTest gives it for one test, so that the hook
         probe gets past the provider's acquisition and only the provider's check of its caller's uid can refuse it, and
         takes it back. -->
    <uses-permission
        android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />

    <!-- Lets the hook probe see Kestrel, so that only Kestrel's checks can refuse it. -->
    <queries>
        <package android:name="dev.kestrel" />
    </queries>

    <!-- Fixture screens for Kestrel's instrumented tests (design spec, section 16.3). This app is never shipped. -->
    <application
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="Kestrel fixtures"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".FixturesActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Lets tests open the app with a link, as Kestrel opens links and deep links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kestrel-fixtures" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ViewsActivity"
            android:exported="true" />
        <activity
            android:name=".ScrollActivity"
            android:exported="true" />
        <activity
            android:name=".GesturesActivity"
            android:exported="true" />
        <activity
            android:name=".ComposeActivity"
            android:exported="true" />
        <activity
            android:name=".WebActivity"
            android:exported="true" />
        <activity
            android:name=".SecureActivity"
            android:exported="true" />
        <activity
            android:name=".HookProbeActivity"
            android:exported="true" />
        <activity
            android:name=".CommandsActivity"
            android:exported="true" />
        <!-- Shows nothing: it posts or removes the notification and closes. -->
        <activity
            android:name=".NotificationActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <activity
            android:name=".EditActivity"
            android:exported="true" />
        <activity
            android:name=".ComposeEditActivity"
            android:exported="true" />
        <activity
            android:name=".WebEditActivity"
            android:exported="true" />
        <activity
            android:name=".SearchActivity"
            android:exported="true" />
        <!-- Plan 3B: text fixtures -->
        <activity
            android:name=".MediaActivity"
            android:exported="true" />
        <activity
            android:name=".PhoneNumberActivity"
            android:exported="true" />
        <!-- Plan 3C: phone fixtures -->
        <!-- sub-project 5B: fixtures -->
        <!-- The fixture messenger of sub-project 5's agent (design D28). It has no launcher entry of its own, so that the
             agent's app list names this package once, as "Kestrel fixtures"; the tests and scripts open it with am start. -->
        <activity
            android:name=".MessengerActivity"
            android:exported="true"
            android:label="Messenger fixture" />
        <!-- The messenger's share picker, which share_media opens with setPackage. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="Messenger fixture">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <activity
            android:name=".InjectionActivity"
            android:exported="true" />
        <activity
            android:name=".FakeDialogActivity"
            android:exported="true" />
        <activity
            android:name=".StandInActivity"
            android:exported="true" />
        <activity
            android:name=".PressActivity"
            android:exported="true" />
        <!-- sub-project 5C: fixtures -->
        <activity
            android:name=".OcrCanvasActivity"
            android:exported="true" />
        <!-- Sub-project 7: a window over Kestrel's conversation screen, through which touches pass (plan 7F). -->
        <activity
            android:name=".ObscuringActivity"
            android:exported="true" />
        <!-- The event times of a touch, for the test of the device tests' virtual touchscreen. -->
        <activity
            android:name=".TouchTimesActivity"
            android:exported="true" />
    </application>
</manifest>
