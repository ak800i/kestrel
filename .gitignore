# Gradle and Kotlin
.gradle/
.kotlin/
build/
# Source folders named "build", such as the package dev.kestrel.build in build-logic
!**/src/**/build/

# Android Studio
.idea/
*.iml
local.properties
captures/

# Native builds
.cxx/
.externalNativeBuild/

# Screen snapshots from scripts\hook.ps1, which hold real screen content
/screen*.json

# The clips of the voice corpus: the generated ones, which scripts\make-corpus.ps1 makes on demand, and the owner's
# recordings and the A71 session's results, which are private (design spec, section 16.4)
/corpus/generated/
/corpus/owner/
# The results of :tools:eval (scripts\eval.ps1), which can hold personal data, and its local keys (design spec, section 16.5)
/eval-results/
/eval/local/
# The release signing key, which lives only in the owner's folders and in GitHub's secrets.
/release-key/
*.p12
*.jks
*.keystore
